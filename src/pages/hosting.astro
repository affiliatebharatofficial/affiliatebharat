---
import { getCollection } from 'astro:content';
import Layout from '../components/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const articles = (await getCollection('articles'))
  .filter((a) => a.data.category === 'hosting')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const slugOf = (id: string) => id.replace(/\.md$/, '');
---

<Layout
  title="Web Hosting Guides"
  description="Web hosting, domain aur website setup ke honest Hinglish guides — kaun sa plan kis ke liye sahi hai, renewal price traps se kaise bachein."
  canonicalPath="/hosting/"
>
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Hosting' }]} />
  <h1>🖥️ Web Hosting Guides</h1>
  <p class="intro">
    Hosting lena aasaan hai — sahi hosting chunna mushkil. Yahan hum shared hosting plans,
    renewal price ke traps, aur Indian users ke liye GST invoice jaise practical sawaalon par
    researched guides likhte hain. Koi fake 'humne test kiya' daava nahi — sirf public data
    aur honest analysis.
  </p>

  {articles.length > 0 ? (
    <div class="grid">
      {articles.map((a) => (
        <ArticleCard
          href={`/${slugOf(a.id)}/`}
          title={a.data.title}
          description={a.data.description}
          category={a.data.category}
          date={a.data.date}
        />
      ))}
    </div>
  ) : (
    <p class="empty">Hosting guides bahut jald aa rahe hain — content calendar par kaam chal raha hai.</p>
  )}

  <section class="related-tools">
    <h2 class="section-title">Related tools</h2>
    <div class="grid">
      <article class="card">
        <span class="badge">🧮 Tool</span>
        <h3><a href="/tools/hosting-compare/">Hosting Compare Tool</a></h3>
        <p>Plans ko side-by-side compare karo — intro vs renewal price ke saath.</p>
      </article>
      <article class="card">
        <span class="badge">💰 Tool</span>
        <h3><a href="/tools/website-cost-calculator/">Website Cost Calculator</a></h3>
        <p>Website banane ka total kharcha nikalo.</p>
      </article>
    </div>
  </section>
</Layout>

<style>
  h1 { font-size: clamp(1.9rem, 5vw, 2.6rem); margin: 0 0 0.8rem; }
  .intro { color: var(--muted); max-width: 720px; margin: 0 0 2rem; font-size: 1.05rem; }
  .empty { color: var(--muted); background: var(--surface); border: 1px dashed var(--border); border-radius: 0.9rem; padding: 1.5rem; }
  .related-tools { margin-top: 3rem; }
</style>
