---
import { getCollection } from 'astro:content';
import Layout from '../components/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const articles = (await getCollection('articles'))
  .filter((a) => a.data.category === 'finance')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const slugOf = (id: string) => id.replace(/\.md$/, '');
---

<Layout
  title="Finance Guides"
  description="Demat accounts, credit cards aur money tools ke honest Hinglish guides — charges, hidden fees aur fine print samajh ke faisla karo."
  canonicalPath="/finance/"
>
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Finance' }]} />
  <h1>💳 Finance Guides</h1>
  <p class="intro">
    Paise ka mamla hai — yahan 'best' ka matlab aapke liye sabse sasta aur transparent hona
    chahiye. Hum brokerage charges, AMC, aur hidden fees ko line-by-line samjhate hain.
    Note: ye financial advice nahi hai, sirf researched information.
  </p>

  {articles.length > 0 ? (
    <div class="grid">
      {articles.map((a) => (
        <ArticleCard
          href={`/${slugOf(a.id)}/`}
          title={a.data.title}
          description={a.data.description}
          category={a.data.category}
          date={a.data.date}
        />
      ))}
    </div>
  ) : (
    <p class="empty">Finance guides bahut jald aa rahe hain — content calendar par kaam chal raha hai.</p>
  )}
</Layout>

<style>
  h1 { font-size: clamp(1.9rem, 5vw, 2.6rem); margin: 0 0 0.8rem; }
  .intro { color: var(--muted); max-width: 720px; margin: 0 0 2rem; font-size: 1.05rem; }
  .empty { color: var(--muted); background: var(--surface); border: 1px dashed var(--border); border-radius: 0.9rem; padding: 1.5rem; }
</style>
