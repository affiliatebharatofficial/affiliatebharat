---
import { getCollection } from 'astro:content';
import Layout from '../components/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const articles = (await getCollection('articles'))
  .filter((a) => a.data.category === 'saas-tools')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const slugOf = (id: string) => id.replace(/\.md$/, '');
---

<Layout
  title="SaaS Tools Guides"
  description="Email marketing, SEO, AI aur business tools ki honest Hinglish comparisons — pricing, limits aur Indian payment options ke saath."
  canonicalPath="/saas-tools/"
>
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'SaaS Tools' }]} />
  <h1>🛠️ SaaS Tools Guides</h1>
  <p class="intro">
    Har SaaS tool 'best' hone ka daava karta hai. Hum pricing pages, free-plan limits aur
    real user reviews ko khangalte hain taaki aap apne use-case ke liye sahi tool chun sako —
    bina marketing hype ke.
  </p>

  {articles.length > 0 ? (
    <div class="grid">
      {articles.map((a) => (
        <ArticleCard
          href={`/${slugOf(a.id)}/`}
          title={a.data.title}
          description={a.data.description}
          category={a.data.category}
          date={a.data.date}
        />
      ))}
    </div>
  ) : (
    <p class="empty">SaaS tools guides bahut jald aa rahe hain — content calendar par kaam chal raha hai.</p>
  )}
</Layout>

<style>
  h1 { font-size: clamp(1.9rem, 5vw, 2.6rem); margin: 0 0 0.8rem; }
  .intro { color: var(--muted); max-width: 720px; margin: 0 0 2rem; font-size: 1.05rem; }
  .empty { color: var(--muted); background: var(--surface); border: 1px dashed var(--border); border-radius: 0.9rem; padding: 1.5rem; }
</style>
