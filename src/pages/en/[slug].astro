---
import { getCollection, render } from 'astro:content';
import Layout from '../../components/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import VerdictBox from '../../components/VerdictBox.astro';
import MethodologyBox from '../../components/MethodologyBox.astro';
import Faq from '../../components/Faq.astro';
import ArticleCard from '../../components/ArticleCard.astro';

// English article pages: /en/{slug}/ from the articlesEn collection.
export async function getStaticPaths() {
  const articles = await getCollection('articlesEn');
  return articles.map((article) => ({
    params: { slug: article.id.replace(/\.md$/, '') },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const { data } = article;
const slug = article.id.replace(/\.md$/, '');
const canonicalUrl = `https://affiliatebharat.com/en/${slug}/`;

const categoryLabels: Record<string, string> = {
  hosting: 'Hosting',
  'saas-tools': 'SaaS Tools',
  deals: 'Deals',
};
const categoryLabel = categoryLabels[data.category] ?? data.category;

const fmt = (d: Date) => d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });

// Cross-link to the Hinglish version when it exists.
const articlesHi = await getCollection('articles');
const hasHindi = articlesHi.some((e) => e.id.replace(/\.md$/, '') === slug);

const related = (await getCollection('articlesEn'))
  .filter((a) => a.data.category === data.category && a.id !== article.id)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.title,
    description: data.description,
    datePublished: data.date.toISOString(),
    dateModified: (data.updated ?? data.date).toISOString(),
    author: { '@type': 'Organization', name: 'AffiliateBharat', url: 'https://affiliatebharat.com' },
    publisher: { '@type': 'Organization', name: 'AffiliateBharat', url: 'https://affiliatebharat.com' },
    mainEntityOfPage: canonicalUrl,
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://affiliatebharat.com/en/' },
      { '@type': 'ListItem', position: 2, name: data.title, item: canonicalUrl },
    ],
  },
];

if (data.faq.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: data.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}

const hreflang = hasHindi
  ? [
      { href: `https://affiliatebharat.com/${slug}/`, lang: 'hi' },
      { href: canonicalUrl, lang: 'en' },
    ]
  : [];
---

<Layout
  title={data.title}
  description={data.description}
  lang="en"
  canonicalPath={`/en/${slug}/`}
  jsonLd={jsonLd}
  ogType="article"
  hreflang={hreflang}
>
  <article>
    <Breadcrumb
      items={[
        { label: 'Home', href: '/en/' },
        { label: data.title },
      ]}
    />

    <header class="article-head">
      <span class="badge">{categoryLabel}</span>
      <h1>{data.title}</h1>
      <p class="desc">{data.description}</p>
      <div class="meta">
        <span>📅 {fmt(data.date)}</span>
        {data.updated && <span>· Updated: {fmt(data.updated)}</span>}
        {data.tags.length > 0 && <span>· 🏷️ {data.tags.join(', ')}</span>}
      </div>
      {hasHindi && (
        <p class="lang-switch">🌐 <a href={`/${slug}/`}>हिंग्लिश में पढ़ें</a></p>
      )}
    </header>

    <AffiliateDisclosure lang="en" />

    <div class="article-body">
      <Content />
    </div>

    <VerdictBox verdict={data.verdict} />
    <MethodologyBox lastVerified={data.lastVerified} lang="en" />
    <Faq items={data.faq} />

    {related.length > 0 && (
      <section class="related">
        <h2 class="section-title">Related articles</h2>
        <div class="grid">
          {related.map((r) => (
            <ArticleCard
              href={`/en/${r.id.replace(/\.md$/, '')}/`}
              title={r.data.title}
              description={r.data.description}
              category={r.data.category}
              date={r.data.date}
            />
          ))}
        </div>
      </section>
    )}
  </article>
</Layout>

<style>
  .article-head { max-width: 760px; margin-bottom: 1.5rem; }
  .article-head h1 { font-size: clamp(1.8rem, 5vw, 2.6rem); margin: 0.7rem 0 0.7rem; }
  .desc { color: var(--muted); font-size: 1.08rem; margin: 0 0 0.9rem; }
  .meta { display: flex; flex-wrap: wrap; gap: 0.5rem; font-size: 0.88rem; color: var(--muted); }
  .lang-switch { margin-top: 0.7rem; font-size: 0.92rem; }
  .related { margin: 3rem 0; }
</style>
