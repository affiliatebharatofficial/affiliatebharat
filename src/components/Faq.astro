---
// FAQ accordion rendered from frontmatter `faq`. Also feeds FAQPage JSON-LD.
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

{items.length > 0 && (
  <section class="faq-list" aria-label="FAQ">
    <h2>❓ Aksar puche jaane wale sawaal</h2>
    {items.map((item) => (
      <details>
        <summary>{item.q}</summary>
        <p>{item.a}</p>
      </details>
    ))}
  </section>
)}
